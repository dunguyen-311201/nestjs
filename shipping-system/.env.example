# Copy to .env for local dev: cp .env.example .env
# NestJS's ConfigModule.forRoot({ isGlobal: true }) auto-loads .env from cwd,
# so every app picks these up without prefixing env vars on the command line.

# Postgres (matches docker-compose.yml defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Redis (matches docker-compose.yml defaults)
REDIS_HOST=localhost
REDIS_PORT=6379

# NATS (matches docker-compose.yml defaults)
NATS_URL=nats://localhost:4222

# PII field-level encryption (libs/crypto) - required, no default.
# Must be a 64-character hex string (32 bytes). Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=

# Stripe (task 5.8 - Order Service's checkout/webhook)
# Use a real test-mode secret key from https://dashboard.stripe.com/test/apikeys
# to actually reach Stripe; a placeholder value still lets you exercise every
# code path up to the network call (fails with 401 Invalid API Key).
STRIPE_SECRET_KEY=sk_test_placeholder
# Use the signing secret from `stripe listen` (Stripe CLI) for a real webhook,
# or any value here paired with Stripe.webhooks.generateTestHeaderString(...)
# for a local-only simulated webhook (see docs/reference/ walkthroughs).
STRIPE_WEBHOOK_SECRET=whsec_placeholder
CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success
CHECKOUT_CANCEL_URL=http://localhost:3000/checkout/cancel

# API Gateway proxy targets (task: gateway reverse-proxies to domain
# services so clients only ever call the gateway). Leave commented out to
# use each service's own default port (order=3001, tracking=3003,
# courier=3004, hub=3005, linehaul=3006, dispatcher=3007); override here
# only when a service runs on a non-default host/port (e.g. Docker).
# ORDER_SERVICE_URL=http://localhost:3001
# TRACKING_SERVICE_URL=http://localhost:3003
# COURIER_SERVICE_URL=http://localhost:3004
# HUB_SERVICE_URL=http://localhost:3005
# LINEHAUL_SERVICE_URL=http://localhost:3006
# DISPATCHER_SERVICE_URL=http://localhost:3007

# Per-app HTTP port. Leave commented out - each app's main.ts already falls
# back to its own distinct default (order=3001, tracking=3003, ...), and
# since every app shares this same .env file, setting PORT here would make
# them all try to bind the same port.
# PORT=3001

# SendGrid (Notification service). When SENDGRID_API_KEY is unset the
# service falls back to the logging email adapter (no real emails sent).
# SENDGRID_API_KEY=SG.xxxxx
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# SENDGRID_TO_EMAIL=you@yourdomain.com

# Resend (Notification service). Takes priority over SendGrid when both
# are set. Without a verified domain, Resend only sends from
# onboarding@resend.dev (the default when RESEND_FROM_EMAIL is unset)
# and only to your own Resend account email.
# RESEND_API_KEY=re_xxxxx
# RESEND_TO_EMAIL=you@yourdomain.com
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Clerk Authentication (task: API Gateway session verification)
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
