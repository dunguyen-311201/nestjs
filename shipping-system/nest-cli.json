{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json",
    "builder": "webpack",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  },
  "monorepo": true,
  "root": "apps/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "order": {
      "type": "application",
      "root": "apps/order",
      "entryFile": "main",
      "sourceRoot": "apps/order/src",
      "compilerOptions": {
        "tsConfigPath": "apps/order/tsconfig.app.json"
      }
    },
    "tracking": {
      "type": "application",
      "root": "apps/tracking",
      "entryFile": "main",
      "sourceRoot": "apps/tracking/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tracking/tsconfig.app.json"
      }
    },
    "courier": {
      "type": "application",
      "root": "apps/courier",
      "entryFile": "main",
      "sourceRoot": "apps/courier/src",
      "compilerOptions": {
        "tsConfigPath": "apps/courier/tsconfig.app.json"
      }
    },
    "hub": {
      "type": "application",
      "root": "apps/hub",
      "entryFile": "main",
      "sourceRoot": "apps/hub/src",
      "compilerOptions": {
        "tsConfigPath": "apps/hub/tsconfig.app.json"
      }
    },
    "linehaul": {
      "type": "application",
      "root": "apps/linehaul",
      "entryFile": "main",
      "sourceRoot": "apps/linehaul/src",
      "compilerOptions": {
        "tsConfigPath": "apps/linehaul/tsconfig.app.json"
      }
    },
    "dispatcher": {
      "type": "application",
      "root": "apps/dispatcher",
      "entryFile": "main",
      "sourceRoot": "apps/dispatcher/src",
      "compilerOptions": {
        "tsConfigPath": "apps/dispatcher/tsconfig.app.json"
      }
    },
    "notification": {
      "type": "application",
      "root": "apps/notification",
      "entryFile": "main",
      "sourceRoot": "apps/notification/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification/tsconfig.app.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "dtos": {
      "type": "library",
      "root": "libs/dtos",
      "entryFile": "index",
      "sourceRoot": "libs/dtos/src",
      "compilerOptions": {
        "tsConfigPath": "libs/dtos/tsconfig.lib.json"
      }
    },
    "crypto": {
      "type": "library",
      "root": "libs/crypto",
      "entryFile": "index",
      "sourceRoot": "libs/crypto/src",
      "compilerOptions": {
        "tsConfigPath": "libs/crypto/tsconfig.lib.json"
      }
    }
  }
}
