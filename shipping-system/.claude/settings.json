{
  "permissions": {
    "allow": [
      "Bash(pnpm test *)",
      "Bash(pnpm build *)",
      "Bash(pnpm lint *)",
      "mcp__claude_ai_Google_Drive__read_file_content"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-sql.sh"
          }
        ]
      }
    ]
  }
}
